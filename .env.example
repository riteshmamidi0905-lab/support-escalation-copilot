# Copy to .env (git-ignored). Development-only throw-away values; none of these are real secrets.
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_USER=copilot_admin
POSTGRES_DB=copilot
POSTGRES_PORT=5433
# Used by the DB tests when running against docker compose:
# COPILOT_TEST_DATABASE_URL=postgresql://copilot_admin:dev-only-change-me@127.0.0.1:5433/copilot

# M1 environment (rebuild CLI). Generate throw-away values, e.g.:  python -c "import secrets;print(secrets.token_hex(32))"
# COPILOT_ADMIN_DSN=postgresql://copilot_admin:dev-only-change-me@127.0.0.1:5433/copilot
# COPILOT_APP_PASSWORD=...
# COPILOT_LOADER_PASSWORD=...
# COPILOT_INTAKE_PASSWORD=...
# COPILOT_CONTROL_PASSWORD=...     # M3 control service (approvals, idempotency, audit)
# COPILOT_IDENTITY_SECRET=...      # M3 mock identity provider signing key (>= 32 bytes). Never commit, never log.
# COPILOT_SCOPE_SECRET=...        # at least 32 bytes; signs tenant scopes. Never commit, never log.
