{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://support-escalation-copilot.example/contracts/deployment.schema.json",
  "title": "Deployment",
  "description": "",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "deployment_id": {
      "type": "string",
      "pattern": "^DEP-[0-9]{4,6}$"
    },
    "component": {
      "enum": [
        "scheduler",
        "tracking",
        "carrier_gateway",
        "billing",
        "public_api"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "deployed_at": {
      "type": "string",
      "format": "date-time"
    },
    "change_summary": {
      "type": "string"
    }
  },
  "required": [
    "deployment_id",
    "component",
    "version",
    "deployed_at",
    "change_summary"
  ]
}
