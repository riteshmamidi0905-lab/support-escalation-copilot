{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://support-escalation-copilot.example/contracts/audit_event.schema.json",
  "title": "Audit event",
  "description": "Append-only; hash chain makes tampering detectable. Payload never contains secrets or hidden reasoning.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "user",
            "agent",
            "system"
          ]
        },
        "id": {
          "type": "string"
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "type": {
      "enum": [
        "case_opened",
        "evidence_retrieved",
        "tool_called",
        "hypothesis_recorded",
        "action_proposed",
        "approval_requested",
        "approval_decided",
        "approval_expired",
        "action_executed",
        "action_refused",
        "escalated",
        "abstained",
        "injection_detected",
        "isolation_violation_blocked",
        "case_closed",
        "policy_decided",
        "execution_attempted",
        "execution_uncertain",
        "idempotent_replay",
        "idempotency_conflict_blocked",
        "draft_created",
        "forbidden_action_attempted",
        "approval_denied_by_approver"
      ]
    },
    "payload": {
      "type": "object"
    },
    "prev_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "hash": {
      "type": "string"
    },
    "account_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "action_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "action_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "required": [
    "event_id",
    "case_id",
    "ts",
    "actor",
    "type",
    "payload",
    "prev_hash",
    "hash"
  ]
}
