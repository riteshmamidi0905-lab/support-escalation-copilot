{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://support-escalation-copilot.example/contracts/action.schema.json",
  "title": "Typed action proposal",
  "description": "The ONLY write vocabulary the copilot may propose. 'send_customer_email' deliberately does not exist (invariant I3).",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
