{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://support-escalation-copilot.example/contracts/public_claims.schema.json",
  "title": "Public claims manifest",
  "description": "The machine-readable contract between this repository and anything that wants to quote it (README, a portfolio, a CV). Only verified claims, each with its source artifact, the commit it was verified at, its limitation and where it may be used. Generated by scripts/public_claims.py from reports/m6/release-evidence.json; never edited by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "repository", "project_status", "evidence", "claims"],
  "properties": {
    "manifest_version": {"const": "1"},
    "repository": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"},
    "project_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customer", "data", "deployment", "model", "real_model_evaluation"],
      "properties": {
        "customer": {"const": "Meridian Freight Systems is fictional"},
        "data": {"const": "all data is synthetic and generated from a seed"},
        "deployment": {"const": "reference implementation; never deployed; no production use; no real customers"},
        "model": {"const": "the workflow's model is the deterministic stand-in RuleCaseModel, not an LLM"},
        "real_model_evaluation": {"enum": ["not executed", "executed"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "code_sha"],
      "properties": {"file": {"type": "string"}, "code_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "kind", "category", "evidence_class", "model", "source_artifacts", "source_commit", "qualification", "suitable_for"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,60}$"},
          "claim": {"type": "string", "minLength": 20, "maxLength": 600},
          "kind": {"enum": ["capability", "measurement", "limitation"]},
          "category": {"enum": ["architecture", "security", "tenant_isolation", "approvals", "idempotency", "recovery", "observability", "retrieval", "workflow", "testing", "draft_safety", "operator_experience", "real_model", "scope"]},
          "evidence_class": {"enum": ["deterministic_tests", "mutation_checks", "frozen_heldout_retrieval_eval", "synthetic_dev_retrieval_eval", "standin_workflow_runs", "adversarial_dev_corpus", "manual_browser_pass", "design_documented", "not_executed"]},
          "model": {"enum": ["none", "deterministic_stand_in", "real_llm"]},
          "value": {"type": "object"},
          "source_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "qualification": {"type": "string", "minLength": 20, "maxLength": 700},
          "suitable_for": {
            "type": "object",
            "additionalProperties": false,
            "required": ["readme", "portfolio", "resume"],
            "properties": {"readme": {"type": "boolean"}, "portfolio": {"type": "boolean"}, "resume": {"type": "boolean"}}
          }
        }
      }
    }
  }
}
